.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(76, 175, 80, 0.2);
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.user-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.arrow {
  color: #fff;
  font-size: 36rpx;
}

.status-card {
  background: linear-gradient(135deg, #f0fff3 0%, #e8f8f0 100%);
  border: 2rpx solid #c8e6c9;
  margin-bottom: 28rpx;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-label {
  font-size: 28rpx;
  color: #4a5d4d;
  font-weight: 600;
}

.status-badge {
  padding: 8rpx 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4CAF50;
  border: 1rpx solid #c8e6c9;
}

.status-value {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.value {
  font-size: 72rpx;
  font-weight: 700;
  color: #2e8b57;
}

.unit {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #7a8a7a;
}

.status-detail {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 18rpx;
  padding: 16rpx 0;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-label {
  font-size: 22rpx;
  color: #7a8a7a;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #2e8b57;
}

.status-footer {
  font-size: 24rpx;
  color: #4CAF50;
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #c8e6c9;
}

.stats-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.small-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #f5fff7 0%, #eef9f1 100%);
  border: 1rpx solid #d8e8dd;
  border-radius: 20rpx;
  padding: 22rpx;
}

.stat-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.stat-content {
  display: flex;
  flex-direction: column;
}

.stat-title {
  font-size: 24rpx;
  color: #4a5d4d;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2e8b57;
}

.stat-subtitle {
  font-size: 20rpx;
  color: #7a8a7a;
  margin-top: 8rpx;
}

.goals-card {
  margin-bottom: 28rpx;
}

.goal-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef5ee;
}

.goal-item:last-child {
  border-bottom: none;
}

.goal-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.goal-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.goal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d3b2b;
}

.goal-value {
  font-size: 22rpx;
  color: #7a8a7a;
  margin-top: 4rpx;
}

.goal-status {
  font-size: 32rpx;
  color: #4CAF50;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
  color: #1d3b2b;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef5ee;
}

.record-meta {
  display: flex;
  flex-direction: column;
}

.record-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d3b2b;
}

.record-type {
  font-size: 22rpx;
  color: #7a8a7a;
  margin-top: 4rpx;
}

.record-value {
  font-size: 32rpx;
  font-weight: 700;
}

.no-data {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #7a8a7a;
}

.no-data-sub {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: #aaa;
}
