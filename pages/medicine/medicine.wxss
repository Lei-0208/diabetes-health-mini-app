.reminder-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef5ee;
}

.reminder-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reminder-name {
  font-size: 30rpx;
  font-weight: 700;
}

.time-picker {
  padding: 10rpx 14rpx;
  border: 1rpx solid #dfece2;
  border-radius: 12rpx;
  background: #f8fff9;
  color: #4a5d4d;
}

.action-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

button {
  height: 82rpx;
  line-height: 82rpx;
}
