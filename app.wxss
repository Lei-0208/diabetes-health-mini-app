/* 全局样式 */
page {
  background: linear-gradient(to bottom, #f6fff7 0%, #ffffff 100%);
  color: #1f2d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24r rgba(76, 175, 80, 0.08);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #6ccf72 0%, #4CAF50 100%);
  color: #fff;
  border-radius: 18rpx;
  border: none;
  font-weight: 600;
}

.secondary-btn {
  background: #fff7d6;
  color: #8a6d00;
  border: 1rpx solid #f3d86b;
  border-radius: 18rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d3b2b;
}

.sub-title {
  font-size: 28rpx;
  color: #4a5d4d;
}

.color-green {
  color: #2e8b57;
}

.color-yellow {
  color: #d4a52a;
}

.color-white {
  color: #ffffff;
}
